// Procedural randomized cell colors with sinusoidal UV distortion.
//
color noisy_squares2d(vector2 texcoord, float scale)
{
	vector2 uv = texcoord * scale;
	vector2 warp = vector2(sin(uv.y * scale), sin(uv.x * scale));
	uv += warp / scale;
	float seed = floor(uv.x) + (floor(uv.y) * scale);
	float red = sin(seed * 12.9898) * 43758.5453;
	float green = sin(seed * 78.233) * 23421.631;
	float blue = sin(seed * 39.346) * 12741.371;
	return color(red - floor(red), green - floor(green), blue - floor(blue));
}

void mx_noisy_squares2d_color3(vector2 texcoord, float scale, output color out_)
{
	out_ = noisy_squares2d(texcoord, scale);
}

