<?xml version="1.0"?>
<materialx version="1.39">
  <nodedef name="ND_julia_set" node="julia_set" doc="Metashade Julia set">
    <input name="position" type="vector3" doc="Position sampled in the XY plane; Z is ignored." defaultgeomprop="Pobject" />
    <input name="cx" type="float" doc="Real part of the constant c." value="-0.74543" />
    <input name="cy" type="float" doc="Imaginary part of the constant c." value="0.11301" />
    <input name="scale" type="float" doc="Extent of the complex plane mapped to a unit of position." value="3.0" />
    <input name="max_iterations" type="integer" doc="Maximum number of iterations of z^2 + c." value="64" />
    <input name="phase" type="float" doc="Offset of the color palette." value="0.0" />
    <output name="out" type="color3" doc="Color of the Julia set." />
  </nodedef>
</materialx>
